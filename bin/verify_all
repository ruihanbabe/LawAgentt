#!/usr/bin/env bash
set -euo pipefail
project_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
python_bin="${LAWAGENT_PYTHON:-/root/miniconda3/envs/agent/bin/python}"
cd "${project_root}"
echo "[1/3] compile"
"${python_bin}" -m compileall -q api lawagent_runtime scripts tests main.py
echo "[2/3] unit / contract / SSE seam"
"${python_bin}" -m unittest discover -s tests -v
echo "[3/3] verification coverage"
echo "PASS core compile + unittest"
echo "DEBT real GLM, live Qdrant product E2E, browser E2E, visual, performance, independent review and 30-case evaluation"
echo "See docs/testing/TESTING.md."
