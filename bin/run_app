#!/usr/bin/env bash
set -euo pipefail
project_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
python_bin="${LAWAGENT_PYTHON:-/root/miniconda3/envs/agent/bin/python}"
cd "${project_root}"
exec "${python_bin}" -m uvicorn main:app --host "${LAWAGENT_HOST:-127.0.0.1}" --port "${LAWAGENT_PORT:-8000}"
