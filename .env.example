# Copy to .env and fill local values. .env is ignored by Git.
# Process environment variables override values in this file.

LAWAGENT_GLM_ENABLED=false
LAWAGENT_RAG_ENABLED=false
LAWAGENT_DEV_MODE=false
LAWAGENT_DEV_TOKEN=

# Runtime retrieval assembly
QDRANT_URL=http://127.0.0.1:6333
EMBEDDING_MODEL_PATH=models/bge-m3
DEVICE=auto
CASES_COLLECTION=cases_collection
LAWS_COLLECTION=laws_collection

# Local persistence services. Change development defaults outside isolated local use.
REDIS_URL=redis://:lawagent-dev@127.0.0.1:6379/0
REDIS_PASSWORD=lawagent-dev
POSTGRES_DSN=postgresql://lawagent:lawagent-dev@127.0.0.1:5432/lawagent
POSTGRES_DB=lawagent
POSTGRES_USER=lawagent
POSTGRES_PASSWORD=lawagent-dev

# Zhipu GLM (ZAI_API_KEY remains supported as a legacy alias)
GLM_API_KEY=
ZAI_API_KEY=
GLM_MODEL=glm-4.7-flash
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_MIN_CALL_INTERVAL_SECONDS=5

# Future provider adapters
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
GOOGLE_API_KEY=
DASHSCOPE_API_KEY=
OPENROUTER_API_KEY=
